// Cloudflare Worker config. For now it only serves the static export in `out/`;
// /api/contact (form) and /api/auth (Sveltia CMS login) will be added as Worker code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arhi-mede",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
